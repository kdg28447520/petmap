{
  "buildCommand": "node build.js && node guides.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ],
  "redirects": [
    {
      "source": "/place/tour-2820641",
      "destination": "/place/tour-3537624",
      "statusCode": 301
    },
    {
      "source": "/place/tour-2820641.html",
      "destination": "/place/tour-3537624.html",
      "statusCode": 301
    },
    {
      "source": "/:path((?!ads\\.txt$).*)",
      "has": [{ "type": "host", "value": "^petmap\\.kr$" }],
      "destination": "https://www.petmap.kr/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path((?!ads\\.txt$).*)",
      "has": [
        { "type": "host", "value": "^www\\.petmap\\.kr$" },
        { "type": "header", "key": "x-forwarded-proto", "value": "http" }
      ],
      "destination": "https://www.petmap.kr/:path*",
      "statusCode": 301
    }
  ]
}
