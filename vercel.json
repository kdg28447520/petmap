{
  "buildCommand": "node build.js && node guides.js",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path((?!ads\\.txt$).*)",
      "has": [{ "type": "host", "value": "^petmap\\.kr$" }],
      "destination": "https://www.petmap.kr/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path((?!ads\\.txt$).*)",
      "has": [
        { "type": "host", "value": "^www\\.petmap\\.kr$" },
        { "type": "header", "key": "x-forwarded-proto", "value": "http" }
      ],
      "destination": "https://www.petmap.kr/:path*",
      "statusCode": 301
    }
  ]
}
